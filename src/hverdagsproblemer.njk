<script>
  const header=document.querySelector('header');
  addEventListener('scroll',()=>header.classList.toggle('scrolled',scrollY>8),{passive:true});
  const io=new IntersectionObserver((es)=>{es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}})},{threshold:.12});
  document.querySelectorAll('.reveal').forEach(el=>io.observe(el));

  // right-side scroll rail: active chapter + progress
  const rail=document.querySelector('.rail');
  if(rail){
    const items=[...rail.querySelectorAll('.rail-i')];
    const secs=items.map(a=>document.querySelector(a.getAttribute('href')));
    const upd=()=>{
      const mid=innerHeight*0.4;let idx=0;
      secs.forEach((s,i)=>{if(s&&s.getBoundingClientRect().top<=mid)idx=i;});
      if(innerHeight+scrollY>=document.documentElement.scrollHeight-4)idx=secs.length-1;
      items.forEach((a,i)=>{a.classList.toggle('active',i===idx);a.classList.toggle('done',i<idx);});
    };
    addEventListener('scroll',upd,{passive:true});addEventListener('resize',upd);upd();
  }

  // hero film: muted preview while visible, sound on request
  const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
  const film=document.getElementById('film');
  const frame=document.getElementById('filmFrame');
  const btn=document.getElementById('soundBtn');
  const lbl=btn.querySelector('.lbl');
  const tryPlay=v=>{const p=v.play();if(p&&p.catch)p.catch(()=>{});};
  const syncState=()=>frame.classList.toggle('paused',film.paused);
  film.addEventListener('play',syncState);film.addEventListener('pause',syncState);
  const setSound=on=>{
    film.muted=!on;
    btn.setAttribute('aria-pressed',on?'true':'false');
    lbl.textContent=on?'Slå lyden fra':'Se filmen med lyd';
  };
  btn.addEventListener('click',()=>{
    if(film.muted){setSound(true);film.currentTime=0;tryPlay(film);}
    else setSound(false);
  });
  frame.addEventListener('click',()=>{film.paused?tryPlay(film):film.pause();});
  let filmVisible=false;
  new IntersectionObserver(es=>{es.forEach(e=>{
    filmVisible=e.isIntersecting;
    if(filmVisible){if(!reduce||!film.muted)tryPlay(film);}
    else{film.pause();if(!film.muted)setSound(false);}
  });},{threshold:.35}).observe(frame);
  if(reduce)frame.classList.add("paused");

  // section 02: scrolling scrubs through the intro
  const scrub=document.querySelector('.scrub');
  if(scrub&&!reduce){
    const sv=scrub.querySelector('video'),sticky=scrub.querySelector('.scrub-sticky');
    const fill=scrub.querySelector('.scrub-fill'),tEl=scrub.querySelector('.scrub-t');
    const beats=[...scrub.querySelectorAll('.beat')],froms=beats.map(b=>parseFloat(b.dataset.from));
    const end=parseFloat(scrub.dataset.end);
    let target=0,ticking=false,loaded=false;
    const seek=()=>{if(sv.readyState>=1&&!sv.seeking&&Math.abs(sv.currentTime-target)>0.04)sv.currentTime=target;};
    sv.addEventListener('seeked',seek);sv.addEventListener('loadedmetadata',seek);
    const update=()=>{
      ticking=false;
      const r=scrub.getBoundingClientRect(),top=parseFloat(getComputedStyle(sticky).top)||0;
      const p=Math.min(1,Math.max(0,(top-r.top)/((r.height-sticky.offsetHeight)||1)));
      target=p*end;
      fill.style.width=(p*100)+'%';
      tEl.textContent='0:'+String(Math.floor(target)).padStart(2,'0');
      beats.forEach((b,i)=>{const nxt=i+1<froms.length?froms[i+1]:Infinity;
        b.classList.toggle('on',target>=froms[i]&&target<nxt);b.classList.toggle('past',target>=nxt);});
      seek();
    };
    addEventListener('scroll',()=>{if(!ticking){ticking=true;requestAnimationFrame(update);}},{passive:true});
    addEventListener('resize',update);
    new IntersectionObserver(es=>{es.forEach(e=>{
      if(e.isIntersecting&&!loaded){loaded=true;sv.preload='auto';sv.load();
        const p=sv.play();if(p&&p.then)p.then(()=>{sv.pause();seek();}).catch(()=>{});}
    });},{rootMargin:'600px 0px'}).observe(scrub);
    update();
  }

  // looping clip in section 04 only runs while on screen
  document.querySelectorAll('.loopclip').forEach(v=>{
    new IntersectionObserver(es=>{es.forEach(e=>{
      if(e.isIntersecting&&!reduce)tryPlay(v);else v.pause();
    });},{threshold:.4}).observe(v);
  });
</script>
