<footer id="kontakt">
  <div class="wrap foot">
    <div class="flogo" aria-hidden="true">
      {% include "partials/logo.njk" %}
    </div>
    <div class="row">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
      <a href="mailto:{{ site.email }}">{{ site.email }}</a>
    </div>
    <div class="row">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2 2 0 1 0 0 4 2 2 0 0 0 0-4ZM3 9h4v12H3V9Zm6 0h3.8v1.7h.05c.53-.95 1.83-1.95 3.76-1.95C20.3 8.75 21 11 21 14v7h-4v-6.2c0-1.48-.03-3.4-2.07-3.4-2.07 0-2.39 1.62-2.39 3.3V21H9V9Z"/></svg>
      <a href="{{ site.linkedin }}" target="_blank" rel="noopener">{{ site.name }}</a>
    </div>
  </div>
</footer>
