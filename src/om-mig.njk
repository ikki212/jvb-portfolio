<script>
  const header=document.querySelector('header');
  addEventListener('scroll',()=>header.classList.toggle('scrolled',scrollY>8));
  const io=new IntersectionObserver((es)=>{es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}})},{threshold:.12});
  document.querySelectorAll('.reveal').forEach(el=>io.observe(el));

  // scroll-drawn arcs with a travelling dot
  const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
  const arts=[...document.querySelectorAll('.scroll-art')].map(a=>{
    const path=a.querySelector('.arc'),dot=a.querySelector('.arc-dot');
    const len=path.getTotalLength();
    path.style.strokeDasharray=len;
    if(reduce){path.style.strokeDashoffset=0;const e=path.getPointAtLength(len);dot.setAttribute('cx',e.x);dot.setAttribute('cy',e.y);return null;}
    path.style.strokeDashoffset=len;
    return {a,path,dot,len};
  }).filter(Boolean);
  if(arts.length){
    const draw=()=>arts.forEach(({a,path,dot,len})=>{
      const r=a.getBoundingClientRect();
      let p=(innerHeight-r.top)/(innerHeight*0.8);
      p=Math.max(0,Math.min(1,p));
      path.style.strokeDashoffset=len*(1-p);
      const pt=path.getPointAtLength(len*p);
      dot.setAttribute('cx',pt.x);dot.setAttribute('cy',pt.y);
      dot.style.opacity=p>0.02?1:0;
    });
    addEventListener('scroll',draw,{passive:true});addEventListener('resize',draw);draw();
  }
</script>
